# ============================================================================
# codex remote-control container — configuration. See README.md.
# ============================================================================

# Codex release baked into the image (resolved at build time). Pin it to
# recover from a bad release: set it, then `docker compose build --pull`.
CODEX_VERSION=latest

# Image tag: latest, an exact version (1.0.0), a major (1) or sha-<commit>.
DOCKER_CODEX_IMAGE_TAG=latest

# The container's timezone. CODEX_TZ wins; a bare TZ inherited from the
# invoking shell is used otherwise.
CODEX_TZ=UTC

# ----------------------------------------------------------------------------
# Identity
# ----------------------------------------------------------------------------
# The name this host shows up as in the ChatGPT app. It is the container
# hostname — Codex reads gethostname() and offers no override — so changing it
# renames the device your phone sees.
CODEX_DEVICE_NAME=codex-docker

# Commit identity inside the container (the global gitconfig is not persisted).
CODEX_GIT_USER_NAME=
CODEX_GIT_USER_EMAIL=

# ----------------------------------------------------------------------------
# First launch needs a ChatGPT sign-in (Plus/Pro/Business/Edu/Enterprise).
# Remote control refuses API-key auth outright, so OPENAI_API_KEY /
# CODEX_API_KEY are useless here — and CODEX_ACCESS_TOKEN with a non-token
# value BREAKS the CLI. Do not set any of them.
#
#   docker compose up -d --build
#   docker logs -f codex          # the device code is printed here
# or
#   docker exec -it codex codex-login
# ----------------------------------------------------------------------------

# 1 = the supervisor runs the device-code flow itself and prints/pushes the
# code (a fresh code every 15 minutes until you use one).
# 0 = stay parked in login-required and wait for `codex-login`.
CODEX_DEVICE_LOGIN=1

# How many unattended 15-minute codes to mint back to back before parking
# (each flow polls OpenAI's device-auth endpoint every 5s, and a host nobody
# is home to sign into would otherwise do that for days). Parked = log +
# hourly reminder; `docker exec -it codex codex-login` mints a code any time.
# 0 = never park.
CODEX_DEVICE_LOGIN_CYCLES=4

# ----------------------------------------------------------------------------
# Session behaviour — seeded into $CODEX_HOME/config.toml on FIRST boot only.
# Afterwards the file is yours: edit it in ./data/codex/config.toml.
# ----------------------------------------------------------------------------
# read-only and workspace-write CANNOT work in a container (bubblewrap needs
# unprivileged user namespaces; every command would fail, and the Docker
# socket is unreachable from any real sandbox). danger-full-access skips
# bwrap — which is also the honest description of a container that already
# runs as root with the host Docker socket mounted.
CODEX_SANDBOX_MODE=danger-full-access

# Valid values: on-request (Codex asks; the ChatGPT app shows the prompt on
# your phone) | on-failure | never (fully autonomous). Nothing else: the enum
# names Codex's own error message lists (untrusted, granular) FAIL to load as
# bare strings, and because config.toml is seeded only once, a bad value wedges
# a fresh volume in the login loop until you edit data/codex/config.toml.
CODEX_APPROVAL_POLICY=on-request

# ----------------------------------------------------------------------------
# Supervision
# ----------------------------------------------------------------------------
# The app-server never exits when the bridge breaks — it retries forever — so
# health is an active probe (remoteControl/status/read), not process liveness.
CODEX_PROBE_INTERVAL=30

# Seconds the bridge may stay disconnected before the container is reported
# unhealthy. The built-in reconnect sawtooth caps at 30s, so brief outages are
# normal and should not flap the healthcheck.
CODEX_BRIDGE_GRACE=300

# Minutes of a stuck-but-authenticated bridge before bouncing the app-server
# once. 0 disables. (Restarting is rarely the fix — it only resets a backoff
# that was already capped — but it does clear genuinely wedged states.)
CODEX_BRIDGE_RESTART_MINUTES=30

# CODEX_-prefixed on purpose: compose interpolates from the invoking process's
# environment, and the claude hub exports the unprefixed names into its own
# container — which silently pointed this probe at api.anthropic.com.
CODEX_NETWORK_PROBE_URL=https://chatgpt.com
CODEX_RECONNECT_BACKOFF_MIN=5
CODEX_RECONNECT_BACKOFF_MAX=180

# Seconds to let a graceful drain finish before SIGKILL. The app-server's
# SIGTERM waits for running assistant turns, so a turn wedged from the phone
# would otherwise block a restart forever.
CODEX_RESTART_KILL_TIMEOUT=90

# app-server log verbosity (Rust tracing filter). With this unset you get
# ERROR only, which hides every reconnect and enrollment event.
CODEX_RUST_LOG=info

# Supervisor log verbosity: info | debug.
CODEX_LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Updates
# ----------------------------------------------------------------------------
# Hours between release checks (0 disables).
CODEX_UPDATE_INTERVAL_HOURS=12

# 0 = report a new release and let you rebuild the image (recommended: the
#     build re-asserts that the experimental remoteControl/status/read method
#     the healthcheck depends on still exists).
# 1 = install new releases into ./data/codex and bounce the app-server.
#     Costs ~324MB per release in the volume (old ones are pruned).
CODEX_AUTO_UPDATE=0

# ----------------------------------------------------------------------------
# Optional operator alerts, POSTed to a generic webhook: the sign-in code,
# login-required, bridge outages, fatal config errors, new releases.
# Anything that accepts an HTTP POST works — ntfy, gotify, a Home Assistant
# webhook. Empty = off.
# ----------------------------------------------------------------------------
CODEX_NOTIFY_URL=

# text = plain-text body (default) | json = {"source","event","message"}
CODEX_NOTIFY_FORMAT=text
