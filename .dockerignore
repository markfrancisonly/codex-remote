# The build context is the whole stack dir; data/ holds the live ChatGPT
# credential, the sqlite state and (with CODEX_AUTO_UPDATE=1) a ~324MB
# release tree. The Dockerfile uses none of it.
data/
*.md
.env
.env.example
# Development files are not needed by the runtime image.
.git/
.github/
tests/
__pycache__/
*.pyc
